# postgres container
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# api container
SERVER_ADDRESS=
DATABASE_URL=

# optional: set to 1 or 2 for verbose Bun SQL on stdout
# BUNDEBUG=

# optional: OpenTelemetry export. Leave the endpoint unset to disable export.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.nr-data.net
# OTEL_EXPORTER_OTLP_HEADERS=api-key=
# OTEL_EXPORTER_OTLP_COMPRESSION=gzip
# OTEL_EXPORTER_OTLP_TIMEOUT=10s
# OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=local

# optional: kafka and outbox-publisher overrides. KAFKA_TOPIC also names the
# topic kafka_topics creates. Defaults live in internal/config/config.go; set a
# value here only to override, because an empty value is not a missing value
# KAFKA_BROKERS=kafka:9092
# KAFKA_TOPIC=order.created
# KAFKA_CONSUMER_GROUP=outbox-event-consumer
# OUTBOX_BATCH_SIZE=100
# OUTBOX_CLAIM_TTL=2m

# postgres migrations container
GOOSE_DRIVER=
GOOSE_DBSTRING=
GOOSE_MIGRATION_DIR=
GOOSE_TABLE=
