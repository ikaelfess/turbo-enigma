# postgres container
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# api container
SERVER_ADDRESS=
DATABASE_URL=
UPTRACE_DSN=http://project1_secret@uptrace:80?grpc=4317

# optional: set to 1 or 2 for verbose Bun SQL on stdout
# BUNDEBUG=

# optional: kafka overrides for the go services, and KAFKA_TOPIC also names the
# topic kafka_topics creates. Defaults live in internal/config/config.go; set a
# value here only to override, because an empty value is not a missing value
# KAFKA_BROKERS=kafka:9092
# KAFKA_TOPIC=order.created
# KAFKA_CONSUMER_GROUP=outbox-event-consumer

# postgres migrations container
GOOSE_DRIVER=
GOOSE_DBSTRING=
GOOSE_MIGRATION_DIR=
GOOSE_TABLE=
